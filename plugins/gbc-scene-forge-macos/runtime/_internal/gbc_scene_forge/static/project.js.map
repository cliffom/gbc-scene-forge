import { record } from '../shared/decode.mts';
import { HttpError } from '../shared/errors.mts';

/** Quiet time after an observed scene edit; explicit flushes bypass this delay. */
export const SCENE_CHECKPOINT_DEBOUNCE_MS = 750;
/** Retry/flush cadence while mounted; busy and gesture gates remain in the controller. */
export const SCENE_CHECKPOINT_FLUSH_INTERVAL_MS = 5000;

/** Serializes checkpoint writes and cleanup, including edits made during a request. */
export class DraftWriter {
  private draftId = crypto.randomUUID();
  get id() {
    return this.draftId;
  }
  revision: string | null = null;
  // Observe captures immutable JSON once. Deferred writes cannot see later caller
  // mutations, and transient refreshes do not encode the previous scene again.
  private desired = 'null';
  private saved = '';
  private retryValue: Record<string, unknown> | null | undefined;
  private timer: ReturnType<typeof setTimeout> | undefined;
  private pending: Promise<void> = Promise.resolve();
  private stopped = false;
  private send: (route: string, data: Record<string, unknown>) => Promise<Record<string, unknown>>;
  private report: (message: string) => void;
  private async persist(value: Record<string, unknown> | null): Promise<void> {
    if (value) {
      let result: Record<string, unknown>;
      try {
        result = await this.send('checkpoint-draft', {
          ...value,
          id: this.id,
          revision: this.revision,
        });
      } catch (error) {
        if (!(error instanceof HttpError) || error.status !== 409) {
          throw error;
        }
        const listing = await this.send('list-drafts', {});
        if (
          !Array.isArray(listing.drafts) ||
          listing.drafts.some(
            (draft: unknown) =>
              !draft || typeof draft !== 'object' || !('id' in draft) || draft.id === this.id,
          )
        ) {
          throw error;
        }
        // Another tab removed our checkpoint. Use a fresh identity so a concurrent
        // recreation of the old identity can never be overwritten.
        this.draftId = crypto.randomUUID();
        this.revision = null;
        this.saved = '';
        result = await this.send('checkpoint-draft', { ...value, id: this.id, revision: null });
      }
      if (typeof result.revision !== 'string') {
        throw Error('Invalid checkpoint response');
      }
      this.revision = result.revision;
    } else if (this.revision) {
      await this.send('delete-draft', { id: this.id, revision: this.revision });
      this.revision = null;
    }
  }
  constructor(
    send: (route: string, data: Record<string, unknown>) => Promise<Record<string, unknown>>,
    report: (message: string) => void,
  ) {
    this.send = send;
    this.report = report;
  }
  observe(value: Record<string, unknown> | null) {
    if (this.stopped) {
      return;
    }
    const key = JSON.stringify(value);
    if (key === this.desired && this.timer) {
      return;
    }
    this.desired = key;
    if (key === this.saved) {
      return;
    }
    clearTimeout(this.timer);
    this.timer = setTimeout(() => {
      this.timer = undefined;
      void this.flush();
    }, SCENE_CHECKPOINT_DEBOUNCE_MS);
  }
  flush(): Promise<void> {
    clearTimeout(this.timer);
    this.timer = undefined;
    this.pending = this.pending.then(async () => {
      if (this.stopped) {
        return;
      }
      const key = this.retryValue === undefined ? this.desired : JSON.stringify(this.retryValue);
      if (key === this.saved) {
        return;
      }
      const value =
        this.retryValue === undefined
          ? key === 'null'
            ? null
            : record(JSON.parse(key))
          : this.retryValue;
      try {
        await this.persist(value);
        if (value) {
          this.report('Draft checkpoint saved');
        } else {
          this.report('');
        }
        this.saved = key;
        this.retryValue = undefined;
      } catch (error) {
        // A rejected request can be replaced by newer edits. An uncertain acknowledgement
        // must replay the same payload so the server can recognize an idempotent retry.
        this.retryValue =
          error instanceof HttpError && error.status >= 400 && error.status < 500
            ? undefined
            : value;
        this.report(
          `Draft recovery unavailable: ${error instanceof Error ? error.message : String(error)}. Save or export your work. Retrying automatically.`,
        );
      }
    });
    return this.pending;
  }
  /** Confirm the latest desired snapshot before releasing an open scene. */
  async keep() {
    await this.flush();
    // An uncertain older write may have been replayed first; now persist the latest edit.
    if (this.retryValue === undefined && this.saved !== this.desired) {
      await this.flush();
    }
    if (this.retryValue !== undefined || this.saved !== this.desired) {
      throw Error(
        'Could not confirm the recovery draft. The scene remains open; retry or save it.',
      );
    }
    this.stop();
  }
  /** Stop background work without deleting a recoverable checkpoint. */
  stop() {
    clearTimeout(this.timer);
    this.timer = undefined;
    this.stopped = true;
  }
  /** A failed close retains this writer, even if its own checkpoint was removed. */
  resume() {
    this.stopped = false;
    if (!this.revision) {
      this.saved = '';
    }
  }
  async clear() {
    clearTimeout(this.timer);
    // Fence queued writes before deleting; a late response cannot recreate a draft.
    this.stopped = true;
    await this.pending;
    // Recover a lost acknowledgement before deleting, including the first write
    // whose revision we have never received. Failure must be reported to the caller.
    if (this.retryValue !== undefined) {
      await this.persist(this.retryValue);
      this.retryValue = undefined;
    }
    if (this.revision) {
      await this.send('delete-draft', { id: this.id, revision: this.revision });
      this.revision = null;
    }
  }
}
