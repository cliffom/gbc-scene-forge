import { createDocumentClose } from './document-close.mts';
import { createDocumentCommands, type CommandCapabilities } from './document-commands.mts';
import { createPixelEditor } from '../artwork/pixel-editor.mts';
import { createNotifications, feedbackText } from './editor-notifications.mts';
import { EditorLifetime } from './editor-lifetime.mts';
import { createArtworkController } from '../artwork/editor-artwork.mts';
import { createCommandsController } from './editor-commands.mts';
import { createCompositionsController } from './editor-compositions.mts';
import { button, element, input, select } from './editor-dom.mts';
import { createGesturesController } from './editor-gestures.mts';
import { createLayersController } from './editor-layers.mts';
import { createPanelsController } from './editor-panels.mts';
import { createRecoveryController } from '../project/editor-recovery.mts';
import { createRefreshController } from '../project/editor-refresh.mts';
import { createRenderingController } from './editor-rendering.mts';
import { createSceneActionsController } from '../scene/editor-scene-actions.mts';
import {
  BrushState,
  EditorActivity,
  GestureState,
  SceneSelection,
  SceneSession,
  WorkspaceState,
} from './editor-state.mts';
import { createViewportController } from './editor-viewport.mts';
import { createWorkspaceController } from '../project/editor-workspace.mts';
import { ProjectApi } from '../project/project-api.mts';
import { decodeProject, decodeLoaded } from '../project/project-contracts.mts';
import { createAnimationPreview } from '../preview/animation-preview.mts';
import { createBlockoutLabels } from '../blockout/blockout-labels.mts';
import { blockoutDefinitions } from '../blockout/blockout.mts';
import { boolean, number, record, string } from '../shared/decode.mts';
import { createReviewController } from './editor-review.mts';
import { createEditorLayout } from './editor-layout.mts';
import { createEditorShell } from './editor-shell.mts';
import { createFirstSceneGuide } from '../project/first-scene-guide.mts';
import { prunePreviewSettings } from '../preview/preview-settings.mts';

declare const __FORGE_BUILD_LABEL__: string;

/** Compose one independent editor; imports have no DOM or timer side effects. */
export function mountProjectEditor() {
  const versionLabel = document.getElementById('app-version');
  if (versionLabel) {
    versionLabel.textContent = __FORGE_BUILD_LABEL__;
  }
  const lifetime = new EditorLifetime();
  const confirmClose = createDocumentClose(lifetime);
  // Static modal UI belongs to this mount, just like its handlers and state.
  const dialogs = [...document.querySelectorAll('dialog')];
  const popovers = [...document.querySelectorAll<HTMLElement>('[popover]')];
  lifetime.cleanup(() => {
    for (const dialog of dialogs) {
      if (dialog.open) {
        dialog.close();
      }
    }
    for (const popover of popovers) {
      if (popover.matches(':popover-open')) {
        popover.hidePopover();
      }
    }
  });
  const notifications = createNotifications(lifetime, element('editor-workbench', HTMLElement));
  const workspaceState = new WorkspaceState();
  const sceneSession = new SceneSession();
  const sceneSelection = new SceneSelection();
  const brushes = new BrushState();
  const gestures = new GestureState();
  const activity = new EditorActivity();
  let startupPending = true;
  const commandView: { current?: ReturnType<typeof createDocumentCommands> } = {};
  let sceneModified = false;
  const layoutView: { current?: ReturnType<typeof createEditorLayout> } = {};
  const shell = createEditorShell(
    lifetime,
    (kind) => {
      activity.document = kind;
      layoutView.current?.document(kind);
      commandView.current?.render();
    },
    () => editorLayout.showInspector(),
  );
  const scenePresentation = shell.contribute('scene', {
    surface: element('scene-surface', HTMLElement),
    inspector: [
      ...element('inspector-pane', HTMLElement).querySelectorAll<HTMLElement>(
        ':scope > .inspector-panel',
      ),
    ],
    focus: () =>
      (sceneSession.loaded
        ? element('scene', HTMLElement)
        : element('viewport', HTMLElement)
      ).focus({ preventScroll: true }),
  });
  const editorLayout = createEditorLayout(lifetime, (apply) =>
    viewportController.changeLayout(apply),
  );
  layoutView.current = editorLayout;
  const canvas = element('scene', HTMLCanvasElement);
  const blockoutLabels = createBlockoutLabels(canvas, element('viewport', HTMLElement), lifetime);
  const ctx = canvas.getContext('2d');
  if (!ctx) {
    throw Error('Canvas rendering is unavailable');
  }
  const context = ctx;
  const status = notifications.channel(
    'status',
    () =>
      `${workspaceState.project?.id ?? ''}/${activity.document}/${sceneSession.loaded?.id ?? ''}`,
  );
  const projectMatch = /^\/projects\/([^/]+)\//.exec(location.pathname);
  const projectBase = projectMatch ? `/projects/${projectMatch[1]}` : '';
  const transport = new ProjectApi(projectBase, lifetime.signal);
  const api = transport.json.bind(transport);
  const request = transport.request.bind(transport);
  const animationPreview = createAnimationPreview(() => renderingController.draw(false), lifetime);
  async function discard(): Promise<boolean> {
    if (!sceneSession.dirty()) {
      return true;
    }
    const dialog = element('discard-dialog', HTMLDialogElement);
    if (dialog.open) {
      return false;
    }
    return new Promise((resolve) => {
      dialog.addEventListener('close', () => resolve(dialog.returnValue === 'discard'), {
        ...{
          once: true,
        },
        signal: lifetime.signal,
      });
      dialog.returnValue = '';
      dialog.showModal();
    });
  }
  function update(checkpoint = true) {
    if (lifetime.disposed) {
      return;
    }
    // Content equality is evaluated once for this synchronous control refresh.
    const unsaved = sceneSession.dirty();
    sceneModified = unsaved;
    reviewController.sync();
    artworkController.updateTerrain();
    artworkController.syncSourceActions();
    panelsController.renderObjectValidation();
    editorLayout.enableBlockout(
      blockoutDefinitions(workspaceState.project?.definitions ?? []).length > 0,
    );
    panelsController.blockoutView.sync();
    for (const node of element('blockout-presets', HTMLElement).querySelectorAll('button')) {
      node.setAttribute(
        'aria-pressed',
        String(node.dataset.definition === brushes.definitionBrush),
      );
      node.disabled = activity.busy || !sceneSession.editor || gestures.anchor !== null;
    }
    button('show-first-scene-guide').disabled = activity.busy || gestures.anchor !== null;
    for (const id of ['scene-commands', 'project-commands']) {
      button(id).disabled = activity.busy || !workspaceState.project || gestures.anchor !== null;
    }
    button('show-world').disabled =
      activity.busy || !workspaceState.project || gestures.anchor !== null;
    button('show-diagnostics').disabled =
      activity.busy || !workspaceState.project || gestures.anchor !== null;
    button('manage-definitions').disabled =
      activity.busy || !workspaceState.project || gestures.anchor !== null;
    button('place-definition').disabled =
      activity.busy ||
      !sceneSession.editor ||
      !select('object-definition-brush').value ||
      gestures.anchor !== null;
    select('object-definition-brush').disabled = activity.busy || !workspaceState.project;
    if (checkpoint) {
      recoveryController.checkpoint(unsaved);
    }
    for (const key of ['tiles', 'sprites', 'geometry', 'gameplay', 'guides']) {
      input(`view-${key}`).disabled =
        activity.busy ||
        !sceneSession.editor ||
        gestures.anchor !== null ||
        !!sceneSession.editor.stroke;
    }
    button('show-recovery').disabled = activity.busy || gestures.anchor !== null || unsaved;
    panelsController.palettePanel.sync(
      workspaceState.project?.paletteProfile ?? null,
      activity.busy || gestures.anchor !== null,
    );
    if (activity.busy || !sceneSession.editor) {
      gestures.spacePan = false;
      gesturesController.finishPan();
    }
    gesturesController.syncPanCursor();
    select('switch-project').disabled = activity.busy || gestures.anchor !== null || !projectBase;
    button('show-new-project').disabled = button('back-to-projects').disabled = activity.busy;
    for (const id of ['switch-save', 'switch-discard', 'switch-cancel']) {
      button(id).disabled = activity.busy;
    }
    for (const id of ['scene-switch-save', 'scene-switch-discard', 'scene-switch-cancel']) {
      button(id).disabled = activity.busy;
    }
    element('dirty', HTMLElement).textContent = !sceneSession.editor
      ? 'NO SCENE'
      : unsaved
        ? 'UNSAVED'
        : 'SAVED';
    element('dirty', HTMLElement).dataset.dirty = String(unsaved);
    button('save-preview-settings').disabled = activity.busy || !workspaceState.project;
    const saveState = element('scene-save-state', HTMLElement);
    const saveText = !sceneSession.editor ? '' : unsaved ? 'Unsaved changes' : 'Saved';
    if (saveState.textContent !== saveText) {
      saveState.textContent = saveText;
    }
    saveState.dataset.dirty = String(unsaved);
    button('review-mode').disabled =
      activity.busy ||
      !sceneSession.editor ||
      gestures.anchor !== null ||
      !!sceneSession.editor.stroke;
    for (const id of ['toggle-library', 'toggle-inspector', 'expand-scene-tools']) {
      button(id).disabled =
        activity.busy || gestures.anchor !== null || !!sceneSession.editor?.stroke;
    }
    button('fit-scene').disabled = !sceneSession.editor;
    select('zoom').disabled = !sceneSession.editor;
    button('library-import').disabled = activity.busy || gestures.anchor !== null;
    button('show-artwork').disabled =
      activity.busy || !workspaceState.project || gestures.anchor !== null;
    button('edit-placement-artwork').disabled =
      activity.busy || !sceneSession.editor || gestures.anchor !== null;
    button('show-export').disabled =
      activity.busy || !workspaceState.project || gestures.anchor !== null;
    button('show-palettes').disabled =
      activity.busy || !workspaceState.project || gestures.anchor !== null;
    button('export-confirm').disabled = button('export-cancel').disabled = activity.busy;
    select('export-scope').disabled = activity.busy;
    input('export-canvas').disabled = activity.busy || !sceneSession.editor || !unsaved;
    button('revert').disabled = activity.busy || !unsaved;
    button('save-stamp').disabled =
      activity.busy || !sceneSession.editor || !hasSceneSelection() || gestures.anchor !== null;
    button('library-save-stamp').disabled = button('save-stamp').disabled;
    element('stamp-prerequisite', HTMLElement).textContent = hasSceneSelection()
      ? 'Save the selected arrangement, then choose Place stamp to reuse it.'
      : 'Open a scene and select tiles or objects first. Use Select (S); enable Across layers to include multiple layers.';
    button('place-stamp').disabled =
      activity.busy || !sceneSession.editor || !select('stamps').value;
    button('place-stamp').setAttribute('aria-pressed', String(brushes.stampBrush !== null));
    button('place-stamp').textContent = brushes.stampBrush ? 'Stop placing' : 'Place stamp';
    select('stamps').title = select('stamps').selectedOptions[0]?.textContent ?? '';
    select('stamps').disabled = activity.busy || !workspaceState.project?.stamps.length;
    button('delete-stamp').disabled = activity.busy || !select('stamps').value;
    input('select-all-layers').disabled =
      activity.busy || !sceneSession.editor || gestures.anchor !== null;
    button('edit-object').disabled =
      activity.busy ||
      !sceneSession.editor ||
      !sceneSelection.selectedObject ||
      !sceneSession.editor.objects.some((item) => item.id === sceneSelection.selectedObject);
    for (const kind of ['point', 'rectangle']) {
      button(`place-${kind}`).setAttribute('aria-pressed', String(brushes.objectBrush === kind));
    }
    button('place-point').disabled = button('place-rectangle').disabled =
      activity.busy || !sceneSession.editor || gestures.anchor !== null;
    button('remove-sprite').disabled =
      activity.busy ||
      !sceneSelection.selectedObject ||
      !sceneSession.editor?.objects.some((r) => r.id === sceneSelection.selectedObject);
    for (const id of ['paint', 'erase', 'fill', 'select', 'pan']) {
      const control = document.querySelector<HTMLInputElement>(`input[value="${id}"]`);
      if (control) {
        control.disabled =
          activity.busy ||
          !sceneSession.editor ||
          (id === 'fill' &&
            (brushes.definitionBrush !== null ||
              brushes.spriteBrush !== null ||
              brushes.objectBrush !== null ||
              sceneSession.editor?.active.type !== 'tilelayer'));
      }
    }
    for (const control of document.querySelectorAll<
      HTMLButtonElement | HTMLInputElement | HTMLSelectElement
    >('#project-form button, #import-form button, #scene-form button')) {
      control.disabled =
        activity.busy ||
        (['generic-apply', 'forge-apply'].includes(control.id) && control.dataset.ready !== 'true');
    }
    button('empty-open').hidden = !workspaceState.sceneChoices.length;
    button('empty-open').disabled = activity.busy || gestures.anchor !== null;
    select('scenes').disabled =
      activity.busy || gestures.anchor !== null || !workspaceState.sceneChoices.length;
    for (const id of ['show-rename', 'show-duplicate-scene', 'show-resize']) {
      button(id).disabled = activity.busy || !sceneSession.editor || gestures.anchor !== null;
    }
    button('scene-manage-confirm').disabled = activity.busy;
    button('resize-confirm').disabled = activity.busy;
    button('show-delete').disabled = activity.busy || !select('scenes').value;
    button('delete-scene-confirm').disabled =
      activity.busy || !sceneActionsController.deleteCandidate;
    button('delete-scene-cancel').disabled = activity.busy;
    button('delete-atlas-confirm').disabled =
      activity.busy ||
      !artworkController.deleteAtlasCandidate ||
      Boolean(
        sceneSession.editor &&
        artworkController.deleteAtlasCandidate &&
        artworkController.usesAtlas(
          sceneSession.editor.scene,
          artworkController.deleteAtlasCandidate.id,
        ),
      );
    button('delete-atlas-cancel').disabled = activity.busy;
    layersController.renderLayers();
    layersController.renderLayerContext();
    layersController.inspect();
    editorLayout.syncToolbar();
    pixelEditor.syncNavigation(unsaved);
  }
  async function run(work: () => Promise<void> | void) {
    if (lifetime.disposed) {
      return;
    }
    const wasDirty = sceneSession.dirty();
    if (activity.busy) {
      return;
    }
    activity.busy = true;
    const operationKey = work.name ? work : (document.activeElement?.closest('button') ?? work);
    const previousFeedback = status.capture();
    document.querySelectorAll('.form-error').forEach((item) => {
      item.textContent = '';
    });
    update();
    try {
      await work();
      previousFeedback.clear(operationKey);
    } catch (error) {
      if (lifetime.disposed) {
        return;
      }
      status.error(error, operationKey);
      const errorField =
        document.querySelector('dialog[open] .form-error') ||
        (!workspaceState.project && document.querySelector('#project-form .form-error'));
      if (errorField) {
        errorField.textContent = feedbackText(error);
      }
    } finally {
      activity.busy = false;
      update();
      if (!lifetime.disposed && wasDirty && !sceneSession.dirty()) {
        void refreshController.checkExternalChanges();
      }
    }
  }
  const firstSceneGuide = createFirstSceneGuide(
    () => !activity.busy,
    editorLayout.reveal,
    lifetime,
  );
  lifetime.assign(button('save-preview-settings'), 'onclick', () => {
    if (!workspaceState.project || activity.busy) {
      return;
    }
    void run(async () => {
      const available: Record<string, string[]> = {};
      for (const [atlasId, atlas] of Object.entries(workspaceState.project?.atlases || {})) {
        const spriteNames = new Set(
          atlas.regions.filter((region) => region.kind === 'sprite').map((region) => region.name),
        );
        const animations = atlas.animations
          .filter((animation) => animation.frames.every((frame) => spriteNames.has(frame.region)))
          .map((animation) => animation.name);
        for (const name of spriteNames) {
          available[`${atlasId}/${name}`] = animations;
        }
      }
      const result = await api('save-preview-settings', record, {
        settings: prunePreviewSettings(animationPreview.settings(), available),
        project_revision: workspaceState.revision,
      });
      workspaceState.project = decodeProject(result.project);
      workspaceState.revision = string(result.revision);
      status.show('Preview settings saved. Scene edits and starting positions are unchanged.');
    });
  });

  const compositionsController = createCompositionsController({
    lifetime,
    sceneSelection,
    sceneSession,
    workspaceState,
    activity,
    gestures,
    animationPreview,
    brushes,
    status,
    api,
    editorLayout,
    canvas,
    ports: {
      allVisible: () => renderingController.allVisible(),
      get regions() {
        return artworkController.regions;
      },
      draw: (...args) => renderingController.draw(...args),

      update: (...args) => update(...args),
      run: (...args) => run(...args),
      refresh: (...args) => workspaceController.refresh(...args),
    },
  });

  const panelsController = createPanelsController({
    lifetime,
    sceneSession,
    workspaceState,
    api,
    status,
    activity,
    gestures,
    sceneSelection,
    canvas,
    brushes,
    editorLayout,
    ports: {
      run: (...args) => run(...args),

      draw: (...args) => renderingController.draw(...args),
      sceneZoom: (...args) => viewportController.sceneZoom(...args),
      tileMetadata: (...args) => artworkController.tileMetadata(...args),
      update: (...args) => update(...args),

      sourceMetadataChoices: (...args) => artworkController.sourceMetadataChoices(...args),
      layerAction: (...args) => layersController.layerAction(...args),
      syncPanCursor: (...args) => gesturesController.syncPanCursor(...args),
      requestSceneOpen: (...args) => sceneActionsController.requestSceneOpen(...args),

      filterPalette: (...args) => artworkController.filterPalette(...args),
      get viewport() {
        return gesturesController.viewport;
      },
      discard: (...args) => discard(...args),
      clearDraft: (...args) => recoveryController.clearDraft(...args),
      refresh: (...args) => workspaceController.refresh(...args),
      open: (...args) => sceneActionsController.open(...args),
      fitScene: (...args) => viewportController.fitScene(...args),
    },
  });

  const layersController = createLayersController({
    lifetime,
    activity,
    sceneSession,
    gestures,
    sceneSelection,
    status,
    brushes,
    workspaceState,
    animationPreview,
    canvas,
    ports: {
      draw: (...args) => renderingController.draw(...args),

      get sprites() {
        return artworkController.sprites;
      },
      previewBlocked: (...args) => renderingController.previewBlocked(...args),
    },
  });

  const workspaceController = createWorkspaceController({
    lifetime,
    workspaceState,
    api,
    projectBase,
    request,
    transport,
    animationPreview,
    status,
    editorLayout,
    firstSceneGuide,
    ports: {
      image: (...args) => artworkController.image(...args),
      replaceImages: (...args) => artworkController.replaceImages(...args),

      palette: (...args) => artworkController.palette(...args),
      run: (...args) => run(...args),
      get blockoutView() {
        return panelsController.blockoutView;
      },
    },
  });

  const artworkController = createArtworkController({
    lifetime,
    workspaceState,
    sceneSession,
    brushes,
    activity,
    gestures,
    editorLayout,
    sceneSelection,
    status,
    api,
    ports: {
      startupPending: () => startupPending,
      syncPanCursor: (...args) => gesturesController.syncPanCursor(...args),
      draw: (...args) => renderingController.draw(...args),

      discard: (...args) => discard(...args),
      run: (...args) => run(...args),
      clearDraft: (...args) => recoveryController.clearDraft(...args),
      refresh: (...args) => workspaceController.refresh(...args),
      open: (...args) => sceneActionsController.open(...args),

      update: (...args) => update(...args),
    },
  });

  const renderingController = createRenderingController({
    status,
    activity,
    lifetime,
    sceneSession,
    sceneSelection,
    canvas,
    brushes,
    context,
    animationPreview,
    workspaceState,
    blockoutLabels,
    gestures,
    ports: {
      tileMetadata: (...args) => artworkController.tileMetadata(...args),

      syncBlockoutZoom: (...args) => viewportController.syncBlockoutZoom(...args),
      sceneZoom: (...args) => viewportController.sceneZoom(...args),
      update: (...args) => update(...args),
      get regions() {
        return artworkController.regions;
      },
      get sprites() {
        return artworkController.sprites;
      },
    },
  });

  const gesturesController = createGesturesController({
    lifetime,
    sceneSession,
    activity,
    gestures,
    canvas,
    sceneSelection,
    brushes,
    status,
    workspaceState,
    animationPreview,
    ports: {
      allVisible: () => renderingController.allVisible(),
      canPlace: (...args) => renderingController.canPlace(...args),
      point: (...args) => renderingController.point(...args),

      draw: (...args) => renderingController.draw(...args),
      requestHoverDraw: () => renderingController.requestHoverDraw(),
      spritePosition: (...args) => renderingController.spritePosition(...args),
      hitObject: (...args) => renderingController.hitObject(...args),

      sceneZoom: (...args) => viewportController.sceneZoom(...args),
      get regions() {
        return artworkController.regions;
      },
      trackHover: (...args) => renderingController.trackHover(...args),
      update: (...args) => update(...args),
    },
  });

  const viewportController = createViewportController({
    lifetime,
    sceneSession,
    workspaceState,
    brushes,
    activity,
    gestures,
    canvas,
    ports: {
      draw: (...args) => renderingController.draw(...args),

      get viewport() {
        return gesturesController.viewport;
      },
      trackHover: (...args) => renderingController.trackHover(...args),
    },
  });

  const reviewController = createReviewController({
    lifetime,
    activity,
    sceneSession,
    gestures,
    canvas,
    draw: () => renderingController.draw(),
    finishPan: () => gesturesController.finishPan(),
  });

  const sceneActionsController = createSceneActionsController({
    lifetime,
    api,
    workspaceState,
    status,
    sceneSession,
    activity,
    gestures,
    brushes,
    projectBase,
    canvas,
    sceneSelection,
    animationPreview,
    ports: {
      confirmClose,
      closeDraft: (keep) => recoveryController.closeDraft(keep),
      afterClose: () => {
        gesturesController.cancelEditing();
        if (!pixelEditor.activateRetained()) {
          scenePresentation.activate(true);
        }
      },
      beforeSceneChange: () => pixelEditor.activateScene(),
      beforeProjectChange: () => pixelEditor.prepareDeparture(),
      discard: (...args) => discard(...args),
      run: (...args) => run(...args),

      clearDraft: (...args) => recoveryController.clearDraft(...args),
      refresh: (...args) => workspaceController.refresh(...args),

      showRecovery: (...args) => recoveryController.showRecovery(...args),
      focusWorldEndpoint: (...args) => panelsController.focusWorldEndpoint(...args),
      focusDiagnostic: (...args) => panelsController.focusDiagnostic(...args),
      get pendingWorldEndpoint() {
        return panelsController.pendingWorldEndpoint;
      },
      set pendingWorldEndpoint(value) {
        panelsController.pendingWorldEndpoint = value;
      },
      get pendingDiagnostic() {
        return panelsController.pendingDiagnostic;
      },
      set pendingDiagnostic(value) {
        panelsController.pendingDiagnostic = value;
      },

      newDraftWriter: (...args) => recoveryController.newDraftWriter(...args),
      draw: (...args) => renderingController.draw(...args),
      drawOverview: (...args) => renderingController.drawOverview(...args),
      get sprites() {
        return artworkController.sprites;
      },
      palette: (...args) => artworkController.palette(...args),
    },
  });

  const recoveryController = createRecoveryController({
    lifetime,
    api,
    activity,
    gestures,
    workspaceState,
    sceneSession,
    status,
    ports: {
      run: (...args) => run(...args),
      refresh: (...args) => workspaceController.refresh(...args),
      open: (...args) => sceneActionsController.open(...args),
      draw: (...args) => renderingController.draw(...args),
    },
  });

  const refreshController = createRefreshController({
    lifetime,
    workspaceState,
    activity,
    sceneSession,
    gestures,
    animationPreview,
    api,
    status,
    sceneSelection,
    ports: {
      refreshChoices: (...args) => workspaceController.refreshChoices(...args),
      closeScene: () => sceneActionsController.closeScene(),
      captureBrush: (...args) => artworkController.captureBrush(...args),
      refresh: (...args) => workspaceController.refresh(...args),
      open: (...args) => sceneActionsController.open(...args),
      restoreBrush: (...args) => artworkController.restoreBrush(...args),
      draw: (...args) => renderingController.draw(...args),

      update: (...args) => update(...args),
    },
  });

  createCommandsController({
    lifetime,
    workspaceState,
    sceneSession,
    activity,
    gestures,
    status,
    request,
    sceneSelection,
    brushes,
    canvas,
    animationPreview,
    ports: {
      allVisible: () => renderingController.allVisible(),
      run: (...args) => run(...args),
      showImport: (...args) => artworkController.showImport(...args),
      filterPalette: (...args) => artworkController.filterPalette(...args),
      draw: (...args) => renderingController.draw(...args),
      syncPanCursor: (...args) => gesturesController.syncPanCursor(...args),
      compositionSelection: (...args) => compositionsController.compositionSelection(...args),
      get regions() {
        return artworkController.regions;
      },
    },
  });
  const pixelEditor = createPixelEditor({
    notifications,
    lifetime,
    api,
    workspaceState,
    sceneSession,
    sceneSelection,
    brushes,
    ports: {
      confirmClose,
      presentation: {
        contribute: (contribution) => shell.contribute('artwork', contribution),
        scene: () => {
          scenePresentation.activate(true);
          viewportController.restoreDocument();
        },
        revealInspector: () => shell.revealInspector(),
        commandsChanged: () => commandView.current?.render(),
        prepareSceneDeparture: () => {
          if (activity.document === 'scene') {
            gesturesController.cancelEditing();
            animationPreview.suspend();
            viewportController.rememberDocument();
          }
        },
        sceneSummary: (modified = sceneSession.dirty()) => ({
          name: sceneSession.loaded?.name ?? 'Scene workspace',
          kind: 'Scene',
          state: !sceneSession.loaded ? '' : modified ? 'Modified' : 'Saved',
          externalChanged: sceneSession.externalChanged,
        }),
        unavailable: () => activity.busy || workspaceState.navigating || gestures.anchor !== null,
      },
      discovered: async (data, eligible) => {
        const snapshot = decodeProject(data.project);
        const discoveredImages = new Map<string, HTMLImageElement>();
        for (const [id, atlas] of Object.entries(snapshot.atlases)) {
          const image = new Image();
          image.src = `${projectBase}/${atlas.png}?revision=${encodeURIComponent(string(data.revision))}`;
          await image.decode();
          discoveredImages.set(id, image);
        }
        const latest = await api('project', record);
        if (eligible() && latest.revision === data.revision) {
          artworkController.palette(false, snapshot, discoveredImages, true);
        }
      },
      run,
      saved: async (ack, reviewedScenes) => {
        const replaced = Array.isArray(ack.replaced_scenes) ? ack.replaced_scenes : [];
        const replacedOpen = sceneSession.loaded && replaced.includes(sceneSession.loaded.id);
        // A rewritten map can advance only the scene base that was reviewed.
        const revisions = record(ack.scene_revisions);
        const sceneChanged = Boolean(
          sceneSession.loaded &&
          reviewedScenes[sceneSession.loaded.id] !== sceneSession.loaded.revision,
        );
        if (
          sceneSession.loaded &&
          !sceneChanged &&
          !replacedOpen &&
          revisions[sceneSession.loaded.id]
        ) {
          const previous = sceneSession.loaded.revision;
          const revision = string(revisions[sceneSession.loaded.id]);
          sceneSession.loaded = { ...sceneSession.loaded, revision };
          if (sceneSession.committed?.revision === previous) {
            sceneSession.committed = { ...sceneSession.committed, revision };
          }
        }
        const data = await api('project', record);
        if (data.revision !== ack.project_revision) {
          throw Error(
            'Artwork was saved, but another writer changed the project. Refresh before continuing.',
          );
        }
        await workspaceController.refresh(data, async () => {
          const current = await api('revisions', record);
          if (current.revision !== ack.project_revision) {
            throw Error('Artwork saved; project changed during reload. Refresh before continuing.');
          }
          return true;
        });
        renderingController.draw();
        if (sceneChanged) {
          throw Error(
            'The open scene changed on disk. Local scene edits and history were retained; reconcile the scene before saving.',
          );
        }
        if (replacedOpen && sceneSession.loaded) {
          if (sceneSession.dirty()) {
            throw Error('Variation saved. Local scene work is retained; reopen to reconcile.');
          }
          const loaded = await api(
            `scene/${encodeURIComponent(sceneSession.loaded.id)}`,
            decodeLoaded,
          );
          if (loaded.revision !== revisions[loaded.id]) {
            throw Error('Variation saved, but the scene changed again. Reopen to reconcile.');
          }
          await recoveryController.clearDraft();
          sceneActionsController.open(loaded, false);
          status.show(
            'Variation saved. Selected placements updated; other references retain the original.',
          );
          return;
        }
        status.show('Artwork saved. Scene edits and undo history are unchanged.');
      },
    },
  });

  function hasSceneSelection() {
    return Boolean(
      sceneSelection.selection ||
      sceneSelection.selectedObject ||
      sceneSelection.selectedObjects.size,
    );
  }
  function sceneCommands(): CommandCapabilities {
    const editor = sceneSession.editor;
    const ready =
      !!editor &&
      !activity.busy &&
      !activity.reviewing &&
      gestures.anchor === null &&
      !editor.stroke;
    const selected = ready && hasSceneSelection();
    const composition = selected && renderingController.allVisible();
    const transform =
      (action: 'copy' | 'cut' | 'paste' | 'duplicate' | 'horizontal' | 'vertical' | 'rotate') =>
      () =>
        compositionsController.compositionAction(action);
    return {
      close: { enabled: ready, run: () => void sceneActionsController.requestClose() },
      save: {
        enabled: ready && sceneModified,
        run: sceneActionsController.save,
        label: 'Save scene',
      },
      undo: {
        enabled: ready && !!editor.undoStack.length,
        run: () => {
          sceneSelection.selection = null;
          editor?.undo();
          renderingController.draw();
        },
      },
      redo: {
        enabled: ready && !!editor.redoStack.length,
        run: () => {
          sceneSelection.selection = null;
          editor?.redo();
          renderingController.draw();
        },
      },
      copy: { enabled: composition, run: transform('copy') },
      cut: { enabled: composition, run: transform('cut') },
      paste: {
        enabled: ready && !!brushes.clipboard && renderingController.allVisible(),
        run: transform('paste'),
      },
      duplicate: { enabled: composition, run: transform('duplicate') },
      horizontal: { enabled: composition, run: transform('horizontal') },
      vertical: { enabled: composition, run: transform('vertical') },
      rotate: { enabled: composition, run: transform('rotate') },
      deselect: {
        enabled: selected,
        run: () => {
          sceneSelection.selection = null;
          sceneSelection.selectedObject = null;
          sceneSelection.selectedObjects.clear();
          renderingController.draw();
        },
      },
    };
  }
  commandView.current = createDocumentCommands(
    lifetime,
    () => (activity.document === 'artwork' ? pixelEditor.commands() : sceneCommands()),
    () =>
      element(activity.document === 'artwork' ? 'art-canvas' : 'scene', HTMLElement).focus({
        preventScroll: true,
      }),
  );
  commandView.current.render();

  // Import boolean decoding here too: reject malformed preview defaults before first render.
  void run(async () => {
    if (!(await workspaceController.refresh()) || lifetime.disposed) {
      return;
    }
    if (workspaceState.project) {
      const data = await api('project', record);
      const preview = record(record(data.project).preview);
      input('grid').checked = boolean(preview.grid);
      select('zoom').value = String(number(preview.zoom));
    }
    status.show(
      workspaceState.project
        ? 'Choose a scene, or import artwork or a map to get started.'
        : workspaceState.choosingProject
          ? 'Choose a project or create a new one.'
          : 'Name your project to get started.',
      { quiet: Boolean(workspaceState.project) },
    );
    if (workspaceState.project) {
      await sceneActionsController.openInitialScene();
      if (new URLSearchParams(location.search).get('blockout') === '1') {
        status.clear();
        history.replaceState(history.state, '', location.pathname);
        editorLayout.showLibrary('blockout');
        panelsController.blockoutView.showCreate();
      } else if (
        ['artwork', 'import'].includes(new URLSearchParams(location.search).get('start') ?? '')
      ) {
        status.clear();
        const goal = new URLSearchParams(location.search).get('start');
        history.replaceState(history.state, '', location.pathname);
        lifetime.frame(() =>
          button(goal === 'artwork' ? 'show-artwork' : 'library-import').click(),
        );
      } else if (new URLSearchParams(location.search).get('guide') === '1') {
        history.replaceState(history.state, '', location.pathname);
        firstSceneGuide.continueInProject();
      }
    }
  }).finally(() => {
    startupPending = false;
    if (!lifetime.disposed) {
      artworkController.filterPalette();
    }
  });

  for (const id of ['scene-manage-dialog', 'resize-scene-dialog']) {
    lifetime.assign(element(id, HTMLDialogElement), 'oncancel', (event) => {
      if (activity.busy) {
        event.preventDefault();
      }
    });
  }

  lifetime.cleanup(() => {
    sceneSession.editor?.cancel();
    gesturesController.finishPan();
    animationPreview.reset();
  });
  return { dispose: () => lifetime.dispose() };
}
