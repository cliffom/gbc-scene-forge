import {
  historyDiff,
  historyApply,
  captureHistoryContext,
  type HistoryChange,
} from './history.mts';
import type { Coordinate, EditorDescriptor, Selection, TileScene } from '../shared/types.ts';
// Editing operations use native scene pixels and semantic cell identifiers.
export const clone = <T,>(value: T): T => structuredClone(value);

export function canvasPoint(
  event: { clientX: number; clientY: number },
  rect: { left: number; top: number; width: number; height: number },
  width: number,
  height: number,
) {
  return {
    x: Math.floor(((event.clientX - rect.left) * width) / rect.width),
    y: Math.floor(((event.clientY - rect.top) * height) / rect.height),
  };
}

/** Per-scene undo count; variable-sized deltas and active transaction copies have no byte cap. */
export const MAX_SCENE_HISTORY_OPERATIONS = 100;

export class Editor<T extends { width: number; height: number; cells?: string[][] } = TileScene> {
  descriptor: EditorDescriptor;
  reasons: Map<string, string>;
  scene: T;
  locked: Set<string>;
  undoStack: HistoryChange[][] = [];
  redoStack: HistoryChange[][] = [];
  stroke: T | null = null;
  protected historyContextKeys: string[] = [];
  constructor(scene: T, locked: Coordinate[], descriptor: EditorDescriptor) {
    if (!descriptor?.erase_cell) {
      throw Error('Scene descriptor needs an erase cell.');
    }
    this.descriptor = descriptor;
    this.reasons = new Map((descriptor.constraints || []).map((c) => [`${c.x},${c.y}`, c.reason]));
    this.scene = clone(scene);
    this.locked = new Set(locked.map(([x, y]) => `${x},${y}`));
    this.undoStack = [];
    this.redoStack = [];
    this.stroke = null;
  }
  get cells(): string[][] {
    if (!this.scene.cells) {
      throw Error('Choose a tile layer.');
    }
    return this.scene.cells;
  }
  get floor() {
    return this.descriptor.erase_cell;
  }
  begin() {
    if (this.stroke === null) {
      this.stroke = clone(this.scene);
    }
  }
  end() {
    if (this.stroke !== null) {
      const changes = historyDiff(this.stroke, this.scene);
      if (changes.length) {
        captureHistoryContext(changes, this.stroke, this.historyContextKeys, 'before');
        captureHistoryContext(changes, this.scene, this.historyContextKeys, 'after');
        this.undoStack.push(changes);
        if (this.undoStack.length > MAX_SCENE_HISTORY_OPERATIONS) {
          this.undoStack.shift();
        }
        this.redoStack = [];
      }
    }
    this.stroke = null;
  }
  cancel() {
    if (this.stroke !== null) {
      this.scene = this.stroke;
    }
    this.stroke = null;
  }
  change(callback: (scene: T) => void) {
    const own = this.stroke === null;
    if (own) {
      this.begin();
    }
    callback(this.scene);
    if (own) {
      this.end();
    }
  }
  check(x: number, y: number) {
    if (x < 0 || y < 0 || x >= this.scene.width || y >= this.scene.height) {
      throw Error('Placement is outside the scene.');
    }
    if (this.locked.has(`${x},${y}`)) {
      throw Error(this.reasons.get(`${x},${y}`) || 'This cell is fixed by the project.');
    }
  }
  stamp(x: number, y: number, cells: string[][]) {
    cells.forEach((row, dy) => row.forEach((_, dx) => this.check(x + dx, y + dy)));
    this.change(() =>
      cells.forEach((row, dy) =>
        row.forEach((cell, dx) => {
          this.cells[y + dy][x + dx] = cell;
        }),
      ),
    );
  }
  fill(x: number, y: number, replacement: string) {
    this.check(x, y);
    const target = this.cells[y][x];
    if (target === replacement) {
      return;
    }
    const found: Coordinate[] = [],
      seen = new Set<string>(),
      pending: Coordinate[] = [[x, y]];
    while (pending.length) {
      const next = pending.pop();
      if (!next) {
        break;
      }
      const [px, py] = next,
        key = `${px},${py}`;
      if (
        seen.has(key) ||
        this.locked.has(key) ||
        px < 0 ||
        py < 0 ||
        px >= this.scene.width ||
        py >= this.scene.height
      ) {
        continue;
      }
      seen.add(key);
      if (this.cells[py][px] !== target) {
        continue;
      }
      found.push([px, py]);
      pending.push([px + 1, py], [px - 1, py], [px, py + 1], [px, py - 1]);
    }
    this.change(() =>
      found.forEach(([px, py]) => {
        this.cells[py][px] = replacement;
      }),
    );
  }
  move(selection: Selection, dx: number, dy: number) {
    const { x, y, w, h } = selection;
    const pixels = this.cells.slice(y, y + h).map((row) => row.slice(x, x + w));
    for (let py = 0; py < h; py++) {
      for (let px = 0; px < w; px++) {
        this.check(x + px, y + py);
        this.check(x + px + dx, y + py + dy);
      }
    }
    this.change(() => {
      for (let py = 0; py < h; py++) {
        for (let px = 0; px < w; px++) {
          this.cells[y + py][x + px] = this.floor;
        }
      }
      pixels.forEach((row, py) =>
        row.forEach((cell, px) => {
          this.cells[y + dy + py][x + dx + px] = cell;
        }),
      );
    });
  }
  erase(selection: Selection) {
    const { x, y, w, h } = selection;
    this.stamp(
      x,
      y,
      Array.from({ length: h }, () => Array.from({ length: w }, () => this.floor)),
    );
  }
  historySome(predicate: (scene: T) => boolean) {
    for (const [stack, direction] of [
      [this.undoStack, 'before'],
      [this.redoStack, 'after'],
    ] as const) {
      let scene = clone(this.scene);
      for (const changes of [...stack].reverse()) {
        scene = historyApply(scene, changes, direction);
        if (predicate(scene)) {
          return true;
        }
      }
    }
    return false;
  }
  undo() {
    const previous = this.undoStack.pop();
    if (!previous) {
      return;
    }
    captureHistoryContext(previous, this.scene, this.historyContextKeys, 'after');
    this.scene = historyApply(this.scene, previous, 'before');
    this.redoStack.push(previous);
  }
  redo() {
    const next = this.redoStack.pop();
    if (!next) {
      return;
    }
    captureHistoryContext(next, this.scene, this.historyContextKeys, 'before');
    this.scene = historyApply(this.scene, next, 'after');
    this.undoStack.push(next);
  }
}
